          },
          "500": {
            "$ref": "#/components/responses/Error500"
          },
          "503": {
            "$ref": "#/components/responses/Error503"
          },
          "200": {
            "description": "Identical enrollment retry returns the original device; it never issues a second identity.",
            "headers": {
              "X-Request-ID": {
                "description": "Server-generated correlation UUID matching the response envelope.",
