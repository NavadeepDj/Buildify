    "/v1/agent/device": {
      "get": {
        "operationId": "getAgentDeviceIdentity",
        "summary": "Verify this device’s independent credential.",
        "description": "Accepts only the opaque device bearer credential. Load its digest/version/status from the authoritative store on every request; reject missing, wrong or revoked credentials as generic 401 invalid_token. User JWTs/public/backend keys are not device identities. No other device/account is selectable. Future commands must recheck revocation atomically when acquiring work.",
