  "components": {
    "securitySchemes": {
      "UserSession": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Verified Supabase user access token from the configured project. Public publishable/anon/service-role keys are not user sessions. A gateway may additionally require an apikey header containing public project configuration."
      },
      "DeviceCredential": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "Opaque device credential",
        "description": "hny_device_<server-issued device UUID>.<32-byte unpadded base64url secret>. Device-only authority; never a Supabase JWT or global provider credential. Public gateway apikey may also be required."
      }
    },
    "schemas": {
      "DeviceSecret": {
        "type": "string",
        "minLength": 43,
        "maxLength": 43,
        "pattern": "^[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$",
        "writeOnly": true,
        "description": "Unpadded base64url of exactly 32 CSPRNG bytes. Generate and durably read back from platform secure storage BEFORE sending. Never log, echo or return this value. Pattern checks encoding, not entropy."
      },
      "DeviceEnrollment": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "enrollment_id",
          "display_name",
          "platform",
          "protocol_version",
          "capabilities",
          "credential_secret"
        ],
        "properties": {
          "enrollment_id": {
            "type": "string",
            "format": "uuid"
          },
          "display_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "\\S"
          },
          "platform": {
            "type": "string",
            "enum": [
              "android",
              "windows",
              "macos",
              "linux"
            ]
          },
          "protocol_version": {
            "type": "string",
            "const": "v1"
          },
          "capabilities": {
            "type": "array",
            "maxItems": 16,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": [
                "host.projects",
                "host.ai",
                "host.databases"
              ]
            }
          },
          "credential_secret": {
            "$ref": "#/components/schemas/DeviceSecret"
          }
        }
      },
      "DeviceRename": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "display_name"
        ],
        "properties": {
          "display_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "\\S"
          }
        }
      },
      "DeviceRotation": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "rotation_id",
          "credential_secret"
        ],
        "properties": {
          "rotation_id": {
            "type": "string",
            "format": "uuid"
          },
          "credential_secret": {
            "$ref": "#/components/schemas/DeviceSecret"
          }
        }
      },
      "Device": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "enrollment_id",
          "display_name",
          "platform",
          "protocol_version",
          "capabilities",
          "status",
          "revision",
          "credential_version",
          "created_at",
          "updated_at",
          "revoked_at"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "enrollment_id": {
            "type": "string",
            "format": "uuid"
          },
          "display_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "\\S"
          },
          "platform": {
            "type": "string",
            "enum": [
              "android",
              "windows",
              "macos",
              "linux"
            ]
          },
          "protocol_version": {
            "type": "string",
            "const": "v1"
          },
          "capabilities": {
            "type": "array",
            "maxItems": 16,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": [
                "host.projects",
                "host.ai",
                "host.databases"
              ]
            }
          },
          "status": {
            "type": "string",
