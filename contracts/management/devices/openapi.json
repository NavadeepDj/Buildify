    "/v1/devices": {
      "post": {
        "operationId": "enrollDevice",
        "summary": "Enroll this hosting installation.",
        "description": "Verified owner session required. Direct enrollment on the host; no pairing code. Never accept owner_id. Idempotency is scoped to verified owner plus enrollment_id and the full normalized request, including secret digest. An identical retry returns the same ID and current record, but never reactivates a revoked device. Different contents under the same enrollment ID return 409. See the lifecycle policy for secure persistence and retry recovery.",
        "tags": [
          "Devices"
        ],
        "security": [
          {
            "UserSession": []
          }
        ],
        "responses": {
          "201": {
            "description": "Successful response. No credential or verifier is returned.",
            "headers": {
              "X-Request-ID": {
                "description": "Server-generated correlation UUID matching the response envelope.",
                "schema": {
                  "type": "string",
                  "format": "uuid"
                }
              },
              "Cache-Control": {
                "description": "Sensitive responses must not be cached.",
                "schema": {
                  "type": "string",
                  "enum": [
                    "no-store"
                  ]
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeviceResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error400"
          },
