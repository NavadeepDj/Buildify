    "/v1/devices/{device_id}/credentials/rotate": {
      "post": {
        "operationId": "rotateOwnedDeviceCredential",
        "summary": "Replace one device credential.",
        "description": "Verified owner session on the hosting installation required. Persist the new candidate secret in secure storage first. Atomic rotation invalidates the old credential with no grace period. An exact retry of the most recent rotation with no intervening mutation returns the committed result before stale If-Match rejection. Reuse of that rotation ID with different inputs returns 409; intervening mutations require reconciliation and 412. Revocation always wins; replay cannot restore access. See lifecycle policy.",
        "tags": [
          "Devices"
        ],
        "security": [
          {
            "UserSession": []
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response. No credential or verifier is returned.",
            "headers": {
              "X-Request-ID": {
                "description": "Server-generated correlation UUID matching the response envelope.",
