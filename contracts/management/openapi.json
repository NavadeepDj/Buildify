              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "Error503": {
        "description": "Required dependency unavailable; authorization fails closed.",
        "headers": {
          "X-Request-ID": {
            "description": "Server-generated correlation UUID matching the response envelope.",
            "schema": {
              "type": "string",
