      "options": {
        "summary": "Preflight for an explicitly allowed browser origin.",
        "description": "No user identity is granted by preflight. Unknown origins are denied. Native clients may omit Origin on the actual request.",
        "tags": [
          "Foundation"
        ],
        "security": [],
