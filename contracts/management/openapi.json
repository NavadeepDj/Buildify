          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "Error405": {
        "description": "Unsupported HTTP method.",
        "headers": {
          "X-Request-ID": {
            "description": "Server-generated correlation UUID matching the response envelope.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          "Cache-Control": {
            "description": "Sensitive responses must not be cached.",
            "schema": {
              "type": "string",
              "enum": [
                "no-store"
              ]
            }
          },
          "Allow": {
            "description": "Methods supported by this route.",
