            "schema": {
              "type": "string",
              "enum": [
                "no-store"
              ]
            }
          },
          "Retry-After": {
            "description": "Positive whole seconds before retrying.",
            "schema": {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,5}$"
            }
          }
        },
        "content": {
          "application/json": {
            "schema": {
