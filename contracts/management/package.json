{
  "name": "hostany-management-contract",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "redocly lint openapi.json --config redocly.yaml",
    "generate": "openapi-typescript openapi.json --output generated/management.d.ts",
    "test": "node --test test/*.test.mjs",
    "check": "npm run lint && npm run generate && npm test && git diff --exit-code -- generated/management.d.ts"
  },
  "devDependencies": {
    "@redocly/cli": "2.72.1",
    "openapi-typescript": "7.13.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1"
  },
  "overrides": {
    "openapi-typescript": {
      "minimatch": "11.0.1"
    }
  }
}
