# Buildify Environment Configuration Example
# Copy this file to .env and configure provider credentials for your environment.
# NEVER commit real production secrets, API keys, or tokens.

# -----------------------------------------------------------------------------
# Cloudflare Tunnel & Domain Settings
# -----------------------------------------------------------------------------
BASE_DOMAIN=buildiify.tech
CF_TUNNEL_ID=
# Private Android build: flutter build apk --dart-define-from-file=.env
# Connector token is embedded in that private APK; do not distribute it publicly.
CF_TUNNEL_TOKEN=
CF_API_TOKEN=
CF_ACCOUNT_ID=
CF_ZONE_ID=
CF_TUNNEL_MANAGEMENT=remote
# Local mode only: existing config.yml, preserving credentials-file.
CF_TUNNEL_CONFIG=
ROUTER_PORT=8787
LIVE_URL_API_PORT=8788
LIVE_URL_API_TOKEN=
RESERVED_SUBDOMAINS=

# -----------------------------------------------------------------------------
# Environment & Application Settings
# -----------------------------------------------------------------------------
BUILDIFY_ENV=development
BUILDIFY_APP_URL=https://buildify.me

# -----------------------------------------------------------------------------
# Email Verification Configuration
# Supported providers: resend | sendgrid | webhook | memory
# -----------------------------------------------------------------------------
BUILDIFY_EMAIL_PROVIDER=memory
BUILDIFY_EMAIL_FROM="Buildify Auth <no-reply@buildify.me>"

# When using Resend (https://resend.com):
BUILDIFY_RESEND_API_KEY=your_resend_api_key_here

# When using SendGrid (https://sendgrid.com):
BUILDIFY_SENDGRID_API_KEY=your_sendgrid_api_key_here

# When using a custom email webhook dispatch service:
BUILDIFY_EMAIL_WEBHOOK_URL=https://api.buildify.me/webhooks/send-verification-email

# -----------------------------------------------------------------------------
# SMS OTP Verification Configuration
# Supported providers: twilio | webhook | memory
# -----------------------------------------------------------------------------
BUILDIFY_SMS_PROVIDER=memory

# When using Twilio (https://www.twilio.com):
BUILDIFY_TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
BUILDIFY_TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
BUILDIFY_TWILIO_FROM_NUMBER=+18005550199

# When using a custom SMS webhook dispatch service:
BUILDIFY_SMS_WEBHOOK_URL=https://api.buildify.me/webhooks/send-sms-otp

# -----------------------------------------------------------------------------
# Verification Expiration & Rate Limits
# -----------------------------------------------------------------------------
# Email verification token validity (default: 30 minutes)
BUILDIFY_EMAIL_TOKEN_LIFETIME_MINUTES=30

# Phone SMS OTP code validity (default: 5 minutes)
BUILDIFY_SMS_OTP_LIFETIME_MINUTES=5

# Resend cooldown duration in seconds (default: 60 seconds)
BUILDIFY_RESEND_COOLDOWN_SECONDS=60

# Max failed OTP attempts before lock out (default: 5)
BUILDIFY_MAX_OTP_ATTEMPTS=5
